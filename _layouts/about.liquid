---
layout: default
---
<div class="post">
  <article>
    {% if page.profile %}
      <div class="profile-hero">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          <div class="profile-image-wrapper">
            {%
              include figure.liquid loading="eager" path=profile_image_path class="img-fluid rounded-circle" sizes="220px" alt=page.profile.image
              cache_bust=true
            %}
          </div>
        {% endif %}

        <h1 class="profile-name">
          {% if site.title == 'blank' %}
            <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
            {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>

        <p class="profile-subtitle">{{ page.subtitle }}</p>

        {% if page.profile.address %}
          <p class="profile-affiliation">{{ page.profile.address | strip_html | strip }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="profile-bio">{{ content }}</div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2 style="margin-top: 30px;">
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Academic Service -->
    {% if page.academic_service %}
      <h2 style="margin-top: 30px;">
        <a href="#" style="color: inherit">academic service</a>
      </h2>
      <div class="academic-service">
        <div class="service-group">
          <div class="service-group-title">Program Committee & Session Chair</div>
          <div class="service-pills">
            <span class="service-pill">AAMAS'22</span>
          </div>
        </div>
        <div class="service-group">
          <div class="service-group-title">Reviewer</div>
          <div class="service-pills">
            <span class="service-pill highlight">NeurIPS'22 (Top Reviewer)</span>
            <span class="service-pill">NeurIPS'23</span>
            <span class="service-pill highlight">NeurIPS'24 (Top Reviewer)</span>
            <span class="service-pill">NeurIPS'25</span>
            <span class="service-pill">EACL'23</span>
            <span class="service-pill">ICML'23</span>
            <span class="service-pill">ICML'24</span>
            <span class="service-pill">ICML'25</span>
            <span class="service-pill">KR'24</span>
            <span class="service-pill">ICLR'24</span>
            <span class="service-pill">ICLR'25</span>
            <span class="service-pill">TMLR</span>
          </div>
        </div>
      </div>
    {%- endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
  </article>
</div>
